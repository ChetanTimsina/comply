{
  "name": "bhutan-bus-system-backend",
  "version": "1.0.0",
  "description": "Backend API for Bhutan Bus System with real-time tracking, digital payments, and fleet management",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix"
  },
  "keywords": [
    "bhutan",
    "bus-system",
    "transit",
