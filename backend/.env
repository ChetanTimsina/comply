# Database Configuration (using SQLite for quick setup)
DATABASE_URL=./bhutan_bus_system.sqlite

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-123456789
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Payment Gateway Configuration (Testing Mode)
STRIPE_SECRET_KEY=sk_test_51234567890abcdef
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef

# Bhutanese Banks (Testing URLs)
BOB_API_URL=https://testapi.bob.com.bt
BNB_API_URL=https://testapi.bnb.com.bt

# Client Configuration
CLIENT_URL=http://localhost:3000

# Google OAuth (Optional - for future features)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret